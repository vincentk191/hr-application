APP_NAME="HR Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=hr_app
DB_USERNAME=hr_app
DB_PASSWORD=hr_app_local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Which entrance a request without the proxy header is treated as. "private" for local work;
# in production leave it unset so that it fails closed (public). See config/entrance.php.
# ENTRANCE_DEFAULT=private
TRUSTED_PROXIES=127.0.0.1,::1

# Modules that can be left out of a release (config/features.php). On unless set to false.
# FEATURE_ATTENDANCE=true
# The automatic sync agents (ingest API, agent screens, "sync now"). Off unless set to true.
# FEATURE_ATTENDANCE_AGENTS=false

# The first System Admin of a real server, created by `php artisan db:seed` when APP_ENV=production
# (see config/initial_admin.php). Not used locally, where DevAccountSeeder makes the example accounts.
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
