# Configuration for docker-compose.server.yml. Copy this to docker/server/.env and fill it in:
#
#   cp docker/server/server.env.example docker/server/.env
#
# Steps, from a fresh clone on the server (Linux with Docker):
#   1. Fill in the values below (APP_KEY: see the line for it).
#   2. docker compose -f docker-compose.server.yml --env-file docker/server/.env up -d --build
#      (the first build takes several minutes: it installs PHP packages and builds the frontend.)
#   3. First run only: set INITIAL_ADMIN_EMAIL and INITIAL_ADMIN_PASSWORD below, then create the roles and the first
#      System Admin (it belongs to no company; no companies are created):
#        docker compose -f docker-compose.server.yml --env-file docker/server/.env exec app php artisan db:seed --force
#      Sign in with that email, create the companies and each company's first HR Admin in the admin panel, and then
#      delete INITIAL_ADMIN_PASSWORD from this file.
#      On a TESTING server only, for example accounts and staff to try things with, set APP_ENV=staging and
#      COMPOSER_DEV=true below BEFORE step 2 (the example seeders refuse to run when APP_ENV=production), then:
#        ... docker compose -f docker-compose.server.yml --env-file docker/server/.env exec app php artisan db:seed --class=DevAccountSeeder --force
#        ... docker compose -f docker-compose.server.yml --env-file docker/server/.env exec app php artisan db:seed --class=OrgHierarchySeeder --force
#      The example accounts (group@hr.test, admin@hr.test, ... all with the password "password") are for testing
#      only. A real server has no accounts yet: the first System Admin and Management accounts are still to be built
#      from the client's details.
#   4. Office-LAN test only: set WEB_BIND and OFFICE_CIDR below for your LAN, then open http://<the server's LAN address>:8090
#      from a device on the office network (private entrance). On a VPS use the SSH tunnel in the README instead.
#   5. WireGuard: open http://localhost:51821 ON THE SERVER, sign in with WG_ADMIN_USER / WG_ADMIN_PASSWORD, add a
#      client per person, and scan its QR code in the WireGuard app. With the VPN on, browse to http://172.30.0.10
#   6. PWA over https (temporary): docker compose -f docker-compose.server.yml --env-file docker/server/.env \
#        --profile tunnel up -d tunnel   then   docker logs hr-server-tunnel-1 2>&1 | grep trycloudflare
#      Open that address on a phone: it arrives as the PUBLIC entrance (employee self-service only).

# --- Application ---------------------------------------------------------------------------------------------------
# Testing server: APP_ENV=staging and COMPOSER_DEV=true. Real server: APP_ENV=production, COMPOSER_DEV=false.
COMPOSER_DEV=false
APP_NAME="HR Dashboard"
APP_ENV=production
APP_DEBUG=false
# Generate one with:  docker run --rm php:8.4-cli php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
APP_KEY=
APP_URL=http://192.168.1.50:8090
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

SESSION_DRIVER=database
# Minutes a session may sit idle (8 hours: about one password and 2FA code per working day), and the most minutes one
# sign-in may last however active it is (24 hours; 0 = no cap).
SESSION_LIFETIME=480
SESSION_ABSOLUTE_LIFETIME=1440
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

# --- Modules ---------------------------------------------------------------------------------------------------------
# false = ship without attendance: its pages, the profile tab, the dashboard card, the ingest API and the daily notice
# are off (404). The calendar and its holidays stay, because leave day counts need them. Switch back to true later.
FEATURE_ATTENDANCE=false
# true = bring back the automatic on-site sync agents. Off: attendance arrives by manual import only.
FEATURE_ATTENDANCE_AGENTS=false

# Stored PDFs (leave attachments, offboarding files) can be shrunk with Ghostscript; employee documents never are.
# OFF here on purpose: Ghostscript would open PDFs uploaded from the public entrance inside the container that holds the
# database password and APP_KEY, and has had sandbox escapes. Turn it on only once compression runs in a separate,
# network-less container (see the security audit, A2).
UPLOADS_COMPRESS_PDF=false
# UPLOADS_PDF_PRESET=/ebook

# --- First System Admin (used once, by db:seed) ----------------------------------------------------------------------
# A temporary password of at least 12 characters; the account must change it at its first sign-in. Remove it afterwards.
INITIAL_ADMIN_NAME="Admin Sistem"
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Database ------------------------------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_DATABASE=hr_app
DB_USERNAME=hr_app
DB_PASSWORD=

# --- Entrances -----------------------------------------------------------------------------------------------------
# The office / LAN range that counts as the private entrance. On a VPS leave it at 127.0.0.1/32 (nothing but the server
# itself): a wide range such as 192.168.0.0/16 also matches other Docker networks and hosting-provider ranges on a shared
# host, and everything inside it would be served the private pages. Only a server sitting inside the office LAN sets
# its real range here, e.g. 192.168.1.0/24.
OFFICE_CIDR=127.0.0.1/32
# Where the web port is published. 127.0.0.1 = this server only, reached through the Nginx that does the https (see the
# README, "A proxy in front of the stack's Nginx": that Nginx must set X-Forwarded-For to $remote_addr, or the public would
# be served the private entrance). Docker's own firewall rules bypass UFW, so never publish this on a public interface.
# For a test in the office LAN only, set the server's LAN address (or 0.0.0.0) and OFFICE_CIDR to the LAN range.
WEB_BIND=127.0.0.1
WEB_PORT=8090
# Left unset so a request Nginx cannot place is treated as public (fails closed).
# ENTRANCE_DEFAULT=public

# --- WireGuard (wg-easy) -------------------------------------------------------------------------------------------
# The address phones use to reach the server's WireGuard port (UDP 51820): its LAN address for testing on the Wi-Fi,
# later its public address or name.
WG_HOST=192.168.1.50
WG_ADMIN_USER=admin
WG_ADMIN_PASSWORD=
# Optional: leave empty until HTTPS over the VPN is set up (README step 7.5). While it is empty, or its certificate does
# not exist yet, Nginx starts without that https and the rest works. Its own hostname, separate from APP_URL's, published
# in ordinary public DNS pointing at 172.30.0.10 (a private address, so the name is harmless to publish — nobody on
# the internet can reach it). Names the certificate Nginx serves there, obtained by DNS-01, which that step covers.
VPN_HOSTNAME=
