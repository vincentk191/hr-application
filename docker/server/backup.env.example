# Settings for docker/server/backup.sh (README, "Backups"). Copy this to docker/server/backup.env, keep it readable by
# root only (chmod 600), and fill it in. The copy with real values is not committed.
#
#   cp docker/server/backup.env.example docker/server/backup.env && chmod 600 docker/server/backup.env
#
# The admin page "Cadangan data" can set the key, the destination, the days and the monitoring addresses too. Where it
# has a value, it wins over this file; where it is blank, this file applies. Whatever the page saves is checked again by
# the script, and anything that does not match is ignored. BACKUP_DIR and BACKUP_IGNORE_PAGE can only be set here.

# The PUBLIC key that every backup is encrypted to (it starts with "age1"). Required here or on the admin page. Create
# the pair on your own computer, never on this server:  age-keygen -o hr-backup-key.txt   (the public key is printed; the
# file holds the private one). Keep the private key file in two safe places, such as a password manager and a printed
# copy in a locked drawer: without it NO backup can be read, and anyone who has it can read all of them.
AGE_RECIPIENT=

# Where the encrypted backups are kept on this server, and how many days of them.
BACKUP_DIR=/var/backups/hr-app
BACKUP_KEEP_DAYS=7

# Where they are copied so that losing this server does not lose them: an rclone destination, such as
# b2:my-bucket/hr-app or sftp-box:hr-app (set it up once with `rclone config`, as root; the credentials stay in rclone's
# own configuration, never in the application). A plain folder, such as a mounted disk (/mnt/usb-backup), also works, but
# only when set here, not from the admin page. Use a path of its own: the old backups there are deleted by this script
# after BACKUP_REMOTE_KEEP_DAYS days (only its own .age, SHA256SUMS and MANIFEST.txt files, but still, do not point it at
# a folder you use for anything else). Leave empty to keep backups on this server only; the script then warns on every run.
BACKUP_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=30

# Optional monitoring, so that a backup that stops working is noticed instead of silently missing. Create a check at a
# service such as healthchecks.io (it expects a ping every day and alerts you when one is missing) and paste its https
# URLs (anything else is refused). The pings carry nothing but the request itself. Leave empty to skip.
BACKUP_OK_URL=
BACKUP_FAIL_URL=

# true = take the admin page out of the picture: only this file is used. For a server where nothing typed into the
# application should ever influence the backups.
BACKUP_IGNORE_PAGE=false
