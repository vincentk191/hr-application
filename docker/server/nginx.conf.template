# Nginx for the server stack. The official image fills ${...} from the container's environment when it starts.
#
# The entrance (CORE-ACC-001) is decided here, from where the request came from, and handed to PHP as a FastCGI
# parameter, which a client cannot set:
#   private  the server itself, the office network (OFFICE_CIDR), and WireGuard peers (they arrive from the VPN network)
#   public   everything else, including the tunnel, which sits on its own network
# Keep the three Docker network ranges in docker-compose.server.yml in step with the lines below.

# When another Nginx on the host does the https and forwards to this one (WEB_BIND=127.0.0.1), every request arrives
# from the host's Docker gateway, which is "private" below. So for those gateway addresses ONLY, the visitor's real
# address is taken from X-Forwarded-For, which that Nginx must always set to $remote_addr (see the README). A client
# cannot use this: from any other source the header is ignored. Keep these in step with the three networks.
set_real_ip_from 172.29.0.1;
set_real_ip_from 172.30.0.1;
set_real_ip_from 172.31.0.1;
real_ip_header X-Forwarded-For;

map $http_x_forwarded_proto $forwarded_https {
    default off;
    https   on;
}

geo $remote_addr $entrance {
    default          public;
    172.29.0.0/24    private;   # the stack's own network: the server itself (localhost) lands here
    172.30.0.0/24    private;   # WireGuard peers, as they leave the VPN container
    172.31.0.1       private;   # the host itself: Docker may route its own connections through any of the three networks
    ${OFFICE_CIDR}   private;   # the office / LAN
}

server {
    listen 80;
    server_name _;

    root /var/www/backend/public;
    index index.php;

    # Room for the largest form: five 5 MB leave attachments, plus the rest of the form. Keep it at or above post_max_size.
    client_max_body_size 30m;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    # The service worker must be revalidated every time, and may control the whole site.
    location = /sw.js {
        add_header Cache-Control "no-cache";
        add_header Service-Worker-Allowed "/";
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
        default_type application/manifest+json;
        try_files $uri =404;
    }

    # Built files have a hash in their name.
    location /build/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Docker's own resolver, and a variable, so Nginx looks `app` up again instead of keeping the address it had when it
    # started: the app container gets a new address whenever it is recreated, and a fixed one gives a 502 until Nginx restarts.
    resolver 127.0.0.11 valid=10s;

    location = /index.php {
        include fastcgi_params;
        set $php_upstream app:9000;
        fastcgi_pass $php_upstream;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param ENTRANCE $entrance;
        fastcgi_param HTTPS $forwarded_https;
        # The app's pages send long response headers (the Link preload hints for the built assets, and cookies). The
        # default buffer is 4k or 8k, and a header that does not fit is a 502 ("upstream sent too big header").
        fastcgi_buffer_size 32k;
        fastcgi_buffers 16 16k;
        fastcgi_busy_buffers_size 32k;
        fastcgi_read_timeout 60s;
    }

    # Nothing else is run as PHP, and dot files are never served.
    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known) { deny all; }
}
