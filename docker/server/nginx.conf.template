# Nginx for the server stack. The official image fills ${...} from the container's environment when it starts.
#
# The entrance (CORE-ACC-001) is decided here, from where the request came from, and handed to PHP as a FastCGI
# parameter, which a client cannot set:
#   private  the server itself, the office network (OFFICE_CIDR), and WireGuard peers (they arrive from the VPN network)
#   public   everything else, including the tunnel, which sits on its own network
# Keep the three Docker network ranges in docker-compose.server.yml in step with the lines below.

# When another Nginx on the host does the https and forwards to this one (WEB_BIND=127.0.0.1), every request arrives
# from the host's Docker gateway, which is "private" below. So for those gateway addresses ONLY, the visitor's real
# address is taken from X-Forwarded-For, which that Nginx must always set to $remote_addr (see the README). A client
# cannot use this: from any other source the header is ignored. Keep these in step with the three networks.
set_real_ip_from 172.29.0.1;
set_real_ip_from 172.30.0.1;
set_real_ip_from 172.31.0.1;
real_ip_header X-Forwarded-For;

map $http_x_forwarded_proto $forwarded_https {
    default off;
    https   on;
}

geo $remote_addr $entrance {
    default          public;
    172.29.0.0/24    private;   # the stack's own network: the server itself (localhost) lands here
    172.30.0.0/24    private;   # WireGuard peers, as they leave the VPN container
    172.31.0.1       private;   # the host itself: Docker may route its own connections through any of the three networks
    ${OFFICE_CIDR}   private;   # the office / LAN
}

server {
    listen 80;
    server_name _;

    root /var/www/backend/public;
    index index.php;

    # Room for the largest form: five 5 MB leave attachments, plus the rest of the form. Keep it at or above post_max_size.
    client_max_body_size 30m;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    # Plain HTTP here is either the host's proxy (which has already done the https, and says so with its header)
    # or an internal hop that never claims to be encrypted; either way the real answer is what it says.
    set $https_flag $forwarded_https;
    include /etc/nginx/snippets/hr-locations.conf;
}

# HTTPS reachable only from WireGuard peers (README, "HTTPS over the VPN"): its own hostname and certificate,
# separate from the public entrance's — VPN_HOSTNAME resolves (in ordinary public DNS) to this address, 172.30.0.10,
# which is private and unreachable from the internet, so the name is harmless to publish and needs no split-horizon
# DNS. VPN_HOSTNAME must be the exact name that certificate was issued for (DNS-01; see the README), and the renewal
# hook (docker/server/reload-after-renew.sh) must reload this container too, or a renewed certificate never reaches
# it — which, with no DNS provider API, is a manual step each time (the README says how often and how).
server {
    listen 172.30.0.10:443 ssl;
    server_name ${VPN_HOSTNAME};

    ssl_certificate     /etc/letsencrypt/live/${VPN_HOSTNAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${VPN_HOSTNAME}/privkey.pem;

    root /var/www/backend/public;
    index index.php;

    client_max_body_size 30m;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    # This Nginx terminates the TLS itself here, so this is never a forwarded claim.
    set $https_flag on;
    include /etc/nginx/snippets/hr-locations.conf;
}
